# 这是本机开发示例，复制为 infra/local.env 后再按需修改。local.env 被 Git 忽略。
POSTGRES_DB=k12_sales
POSTGRES_USER=k12_app
POSTGRES_PASSWORD=change-this-local-password
JWT_SECRET_KEY=change-this-local-jwt-secret
APP_ENCRYPTION_KEY=generate-a-32-byte-urlsafe-base64-key

# 运行环境默认使用百炼；DASHSCOPE_API_KEY 只放在未提交的 infra/local.env 或宿主机密钥管理中。
AI_PROVIDER=bailian
AI_DAILY_BAILIAN_REQUEST_LIMIT=20
AI_WORKFLOW_MAX_ATTEMPTS=3

# 数据保留默认只预览，清理必须人工开启并确认；审计日志和客户不可由清理接口删除。
DATA_RETENTION_AUTO_DELETE=0
DATA_RETENTION_CHAT_MESSAGES_DAYS=730
DATA_RETENTION_AI_FEEDBACK_DAYS=1095
DATA_RETENTION_CUSTOMERS_DAYS=3650
DATA_RETENTION_AUDIT_LOGS_DAYS=3650

# 备份状态阈值；调度脚本默认只创建+校验，不自动清理旧文件。
BACKUP_MAX_AGE_HOURS=24
BACKUP_PRUNE_ENABLED=0

# 本地演示环境按已确认方案启用 Qdrant + 百炼 text-embedding-v4；索引仍需人工触发。
RAG_VECTOR_ENABLED=1
RAG_EMBEDDING_PROVIDER=bailian
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSION=1024
KNOWLEDGE_INDEX_EXECUTION_MODE=queue
QDRANT_COLLECTION=k12_knowledge
QDRANT_VECTOR_SIZE=1024
RAG_MIN_KEYWORD_SCORE=2
RAG_MIN_VECTOR_SCORE=100.35
